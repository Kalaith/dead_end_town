; Based on The Last Hearth's Godot 4.7.2 Compatibility project layout.
config_version=5

[application]
config/name="Dead End Town"
config/version="0.1.0"
config/description="Reclaim a street with survivors who hold the line while you are away."
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/town.tscn"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
ui_accept={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":4194309),Object(InputEventKey,"keycode":4194310),Object(InputEventKey,"keycode":32),Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false)]}
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":4194305),Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":false)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":false)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false)]}
work={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82),Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":false)]}
order_follow={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49),Object(InputEventJoypadButton,"device":-1,"button_index":11,"pressed":false)]}
order_hold={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50),Object(InputEventJoypadButton,"device":-1,"button_index":12,"pressed":false)]}
order_engage={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51),Object(InputEventJoypadButton,"device":-1,"button_index":13,"pressed":false)]}
order_home={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52),Object(InputEventJoypadButton,"device":-1,"button_index":14,"pressed":false)]}
salvage={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"device":-1,"button_index":7,"pressed":false)]}
road_guard={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71),Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":false)]}
team={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70),Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":false)]}
work_board={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"device":-1,"button_index":4,"pressed":false)]}
town_map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77),Object(InputEventJoypadButton,"device":-1,"button_index":9,"pressed":false)]}
shoot={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventKey,"physical_keycode":4194306),Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":false)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055,0.075,0.08,1)
